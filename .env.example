# Copy to .env.local for development. Real values live in Vercel's env var
# settings for preview/production — never commit actual secrets here.
#
# Every value below is a ROTATED replacement for a plaintext secret that was
# committed to the old PHP app's config/config_prod.php — do not reuse the
# old values, generate/rotate fresh ones at the source system.

# --- Database (Google Cloud SQL, kd_customer) ---
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=kd_customer

# --- Redis (Upstash) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Regular-user session + magic link (shared secret with the KD Drupal site) ---
SESSION_SECRET=
NL_AUTH_KEY=
NL_AC_UNSUB_SALT=
NL_AC_ENC_KEY=
NL_AC_ENC_IV=
NL_AC_ENC_CIPHER=AES-256-CBC

# --- Admin auth (Google SSO, /admin/* only) ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAIL_ALLOWLIST=

# --- BBL (internal event log API) ---
BBL_URL=
BBL_AUTH_TOKEN=
BBL_SOURCE=

# --- Mailchimp (campaign HTML fetch only) ---
MAILCHIMP_API_KEY=
MAILCHIMP_HOST=

# --- AWS S3 (newsletter image upload) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
S3_IMAGE_PREFIX=

# --- Google BigQuery (event history + GDPR audit, read-only) ---
GOOGLE_CLOUD_CREDENTIALS_JSON=

# --- InMobile SMS ---
INMOBILE_API_KEY=
INMOBILE_SERVER_URL=

# --- Notifier (internal email dispatch) ---
NOTIFIER_URL=
NOTIFIER_USER=
NOTIFIER_PASSWORD=
