# Copy to .env.local for development. Real values live in Vercel's env var
# settings for preview/production — never commit actual secrets here.
#
# Every value below is a ROTATED replacement for a plaintext secret that was
# committed to the old PHP app's config/config_prod.php — do not reuse the
# old values, generate/rotate fresh ones at the source system.

# --- Database (Google Cloud SQL, kd_customer) ---
# Connected via the Cloud SQL connector (IAM-authenticated tunnel), not a raw
# host:port — Vercel functions have no fixed outbound IP to put in Cloud SQL's
# authorized-networks firewall. Format: "project:region:instance".
DB_INSTANCE_CONNECTION_NAME=
DB_USER=
DB_PASSWORD=
DB_NAME=kd_customer
# Local dev only: path to a service account key with the Cloud SQL Client IAM
# role, e.g. GOOGLE_APPLICATION_CREDENTIALS=config/your-key.json (gitignored).
# On Vercel, GOOGLE_CLOUD_CREDENTIALS_JSON below is used instead — same key,
# pasted as JSON content since there's no persistent filesystem there.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Redis (Upstash) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Regular-user session + magic link (shared secret with the KD Drupal site) ---
SESSION_SECRET=
NL_AUTH_KEY=
NL_AC_UNSUB_SALT=

# --- /auth-token (AES-256-GCM OTP marketing-link token, unrelated to the
# magic link above) — either a 64-char hex string or a base64-encoded Tink
# keyset, see lib/server/email-token.ts. ---
EMAIL_TOKEN_SECRET=

# --- Admin auth (Google SSO, /admin/* only) ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google sign-in is restricted to this domain (decided over allowlist/both —
# see PLAN.md's admin-auth section). Bare domain, no "@", e.g. "k.dk".
ADMIN_EMAIL_DOMAIN=k.dk

# --- BBL (internal event log API) ---
BBL_URL=
BBL_AUTH_TOKEN=
BBL_SOURCE=

# --- ActiveCampaign (contact lookup + event history) ---
ACTIVECAMPAIGN_API_URL=
ACTIVECAMPAIGN_API_TOKEN=

# --- Mandrill (transactional email) — template content/design lives in the
# Mandrill dashboard, these are just the template names this app sends
# against. MANDRILL_TEMPLATE_OPTIN_FOLLOWUP is a follow-up resend of the same
# opt-in ask for anyone who hasn't confirmed yet, not a post-confirm email —
# nothing currently triggers it on a schedule, see
# lib/integrations/mandrill.ts's sendOptInFollowUpEmail.
# MANDRILL_FROM_EMAIL must be on a domain added and verified (SPF/DKIM) as a
# sending domain in the Mandrill account — sends fail silently at the HTTP
# level (200 OK, rejected in the body) without one. ---
MANDRILL_API_KEY=
MANDRILL_FROM_EMAIL=
MANDRILL_FROM_NAME=Kristeligt Dagblad
MANDRILL_TEMPLATE_OPTIN=
MANDRILL_TEMPLATE_OPTIN_FOLLOWUP=

# --- AWS S3 (newsletter image upload) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
S3_IMAGE_PREFIX=

# --- Google Cloud SQL credentials, prod/preview only ---
# Same service account as GOOGLE_APPLICATION_CREDENTIALS above (Cloud SQL
# Client role) — this is its JSON content, for Vercel where there's no file
# path to point to. Only needed as an env var in prod/preview; locally,
# GOOGLE_APPLICATION_CREDENTIALS's file is used instead.
GOOGLE_CLOUD_CREDENTIALS_JSON=
